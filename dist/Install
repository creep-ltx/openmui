; $VER: Install-OpenMUI 2.1 (11.11.2026) OpenMUI 0.1b1
; Amiga Installer script, Installer 43 or newer (OS 3.1: Installer 43.3
; from Aminet; OS 3.2: SYS:System/Installer). tools/release.py fills in the
; lines marked COMPONENT_... when it builds the archive.
;
; What it does:
; - looks for a real MUI (MUI: assign, SYS:MUI, every muimaster.library in
;   the LIBS: directories, MUI's block in S:User-Startup) and says what it
;   found; none of it is changed: Zune goes to the first LIBS: directory,
;   where programs find it before MUI's, and nothing is added to the
;   startup files;
; - writes down every file it puts on the system and keeps every file it
;   replaces in SYS:OpenMUI/Data (Manifest, Backup/): "Use real MUI",
;   "Use OpenMUI" and "Uninstall" in SYS:OpenMUI use that record
;   (Tools/OpenMUISwitch);
; - installs a bundled MUI class only when the user has no newer one of
;   their own (in any LIBS:MUI drawer but MUI's own; classes of a real MUI
;   are written for that MUI and are not used by Zune);
; - an earlier OpenMUI installation is removed first (its backups put
;   back), so that an update starts from the user's own files; the Zune
;   settings (ENVARC:Zune, ENV:Zune) are kept;
; - an installation of the same program under its earlier name, Zune68k
;   lean (SYS:Zune68k, SYS:Prefs/Zune), is removed the same way first:
;   its record is in SYS:Zune68k/Data, and Tools/OpenMUISwitch reads it.

(set @app-name "OpenMUI")
(set @default-dest "")
(if (< @installer-version (* 43 65536))
    (abort "This installation needs Amiga Installer 43 or newer.\n\n"
           "The Installer on the OS 3.1 Install disk is older: use\n"
           "Installer 43.3 (on Aminet in util/misc) or the one of\n"
           "OS 3.2 (SYS:System/Installer).")
)

(set #package (pathonly @icon))
(set #tool (tackon #package "Tools/OpenMUISwitch"))
(set #home "SYS:OpenMUI")
(set #oldhome "SYS:Zune68k")
(set #data (tackon #home "Data"))
(set #backup (tackon #data "Backup"))
(set #manifest (tackon #data "Manifest"))
(set #manifestnew (tackon #data "Manifest.new"))
(set #sysdir (expandpath "SYS:"))
; The first directory of LIBS: and LOCALE:. Through the assign itself a
; drawer that exists only in a later directory (MUI:Libs/mui, MUI:Locale)
; would be MUI's own.
(set #libsdir (expandpath "LIBS:"))
(set #libsmui (tackon #libsdir "MUI"))
(set #zunedir (tackon #libsdir "Zune"))
(set #localedir (expandpath "LOCALE:"))
(set #rec "")
(set #nb 0)
(set #done 0)
(set #report "")
(set #ownlist "")

(procedure P_Version #number
    ("%ld.%ld" (/ #number 65536) (bitand #number 65535))
)

; A path as SYS:..., so that the record survives a renamed boot volume
(procedure P_Rel #p
    (set #rest #p)
    (set #n (strlen #sysdir))
    (if (and (> #n 0) (= (substr #p 0 #n) #sysdir))
        (
            (set #rest (substr #p #n))
            (if (= (substr #rest 0 1) "/")
                (set #rest (cat "SYS:" (substr #rest 1)))
                (if (= (substr #sysdir (- #n 1) 1) ":")
                    (set #rest (cat "SYS:" #rest))
                    (set #rest #p)
                )
            )
        )
    )
    #rest
)

(procedure P_Quote #p
    (cat "\"" #p "\"")
)

; Add the lines gathered in #rec to the record. Installer 43 strings hold
; at most 10000 characters (measured: cat fails above), so the lines are
; written out every 1500 characters and at the end of each step.
(procedure P_SaveRecord
    (if (<> #rec "")
        (
            (if (= (exists #manifest (noreq)) 1)
                (
                    (textfile (dest #manifestnew) (include #manifest) (append #rec))
                    (delete #manifest (optional "force"))
                    (rename #manifestnew #manifest)
                )
                (textfile (dest #manifest)
                    (append "ZUNE68K-MANIFEST 1\nLIBS " (P_Rel #libsdir) "\n" #rec))
            )
            (set #rec "")
        )
    )
)

; Make a drawer (and write it down) unless it is there
(procedure P_MakeDir #dir
    (if (= (exists #dir (noreq)) 0)
        (
            (makedir #dir)
            (set #rec (cat #rec "DIR " (P_Rel #dir) "\n"))
        )
    )
)

; The OpenMUI drawers are always written down (removed when empty)
(procedure P_OwnDir #dir
    (if (= (exists #dir (noreq)) 0) (makedir #dir))
    (set #rec (cat #rec "DIR " (P_Rel #dir) "\n"))
)

; Install the package file #src as #dir/#name. A file already there is
; kept in Data/Backup and written down, for Use real MUI and Uninstall.
(procedure P_Put #src #dir #name
    (set #dst (tackon #dir #name))
    (set #there (exists #dst (noreq)))
    (if (= #there 2)
        (
            (P_SaveRecord)
            (abort (cat #dst " is a drawer, not a file. Nothing was replaced;\n"
                "run Install again and choose Remove to undo what was done."))
        )
    )
    (if (= #there 1)
        (
            (set #nb (+ #nb 1))
            (set #bname (cat "B" #nb "-" #name))
            (copyfiles (source #dst) (dest #backup) (newname #bname) (nogauge))
            (set #rec (cat #rec "REPLACED " (P_Rel #dst) "\nBACKUP " #bname "\n"))
        )
        (set #rec (cat #rec "NEW " (P_Rel #dst) "\n"))
    )
    (if (> (strlen #rec) 1500) (P_SaveRecord))
    (copyfiles (source #src) (dest #dir) (newname #name) (nogauge))
    (set #done (+ #done 1))
)

; A catalog (the language drawers are made by the generated lines)
(procedure P_Catalog #relative #directory
    (P_Put (tackon #package #relative) #directory (fileonly #relative))
)

; The version of a class in #dir, if the file is there
(procedure P_ClassVersion #dir #name
    (set #f (tackon #dir #name))
    (if (= (exists #f (noreq)) 1) (getversion #f) -1)
)

; A bundled MUI class. Installed into LIBS:MUI of the first LIBS: directory
; unless the user has the same or a newer one in a LIBS:MUI drawer; an older
; one there is kept in the backup. MUI's own drawer (MUI:Libs/mui) is not
; looked at for this: its classes belong to that MUI (Use real MUI brings
; them back) and are not used by Zune.
(procedure P_Class #name
    (set #src (tackon (tackon #package "Libs/MUI") #name))
    (set #bv (getversion #src))
    (set #best -1)
    (set #bestat "")
    (set #v (P_ClassVersion #libsmui #name))
    (if (> #v #best) ((set #best #v) (set #bestat #libsmui)))
    (if (<> #other1 "")
        (
            (set #v (P_ClassVersion (tackon #other1 "MUI") #name))
            (if (> #v #best) ((set #best #v) (set #bestat (tackon #other1 "MUI"))))
        )
    )
    (if (<> #other2 "")
        (
            (set #v (P_ClassVersion (tackon #other2 "MUI") #name))
            (if (> #v #best) ((set #best #v) (set #bestat (tackon #other2 "MUI"))))
        )
    )
    (if (<> #other3 "")
        (
            (set #v (P_ClassVersion (tackon #other3 "MUI") #name))
            (if (> #v #best) ((set #best #v) (set #bestat (tackon #other3 "MUI"))))
        )
    )
    (set #own -1)
    (if (<> #muidir "")
        (set #own (P_ClassVersion (tackon #muidir "Libs/mui") #name))
    )
    (if (>= #best #bv)
        (set #report (cat #report #name " " (P_Version #best) ": yours, kept "
            "(OpenMUI's: " (P_Version #bv) ").\n"))
        (
            (if (>= #best 0)
                (if (= #bestat #libsmui)
                    (set #report (cat #report #name " " (P_Version #best)
                        ": yours, older: in the backup, OpenMUI's "
                        (P_Version #bv) " installed.\n"))
                    (set #report (cat #report #name " " (P_Version #best)
                        " in " #bestat ": yours, older, left there.\n"))
                )
            )
            (if (>= #own 0)
                (set #ownlist (cat #ownlist (if (= #ownlist "") "" ", ") #name))
            )
            (P_Put #src #libsmui #name)
        )
    )
)

; What happened to the MUI classes, for the last message
(procedure P_ClassReport
    (cat #report
        (if (<> #ownlist "")
            (cat #muiname "'s own " #ownlist " stay for " #muiname
                "; OpenMUI uses its own.\n")
            ""))
)

(onerror
    (P_SaveRecord)
    (if (and (> #done 0) (= @pretend 0))
        (message "The installation stopped. What was installed so far is "
            "written down: run Install again and choose Remove to put "
            "your system back as it was." (all))
    )
)

(welcome "OpenMUI 0.1b1 (test build): a MUI-compatible user interface "
    "library for AmigaOS 3.x (68000 or better). Not MUI, and not affiliated "
    "with MUI's authors.")

; ---- check the package ----
(if (or
        (<> (exists (tackon #package "Libs/zunemaster.library")) 1)
        (<> (exists (tackon #package "Libs/muimaster.library")) 1)
        (<> (exists #tool) 1)
    )
    (abort "The package is incomplete. Extract the complete archive again.")
)
; COMPONENT_PREFLIGHT

; ---- what is there ----
(set #found "")
(set #muidir "")
(set #muiname "")
(set #muiassign (getassign "MUI" "a"))
(if (<> #muiassign "")
    (set #muidir #muiassign)
    (if (= (exists "SYS:MUI" (noreq)) 2) (set #muidir (expandpath "SYS:MUI")))
)
(set #muiver 0)
(set #muilibs "")
(if (<> #muidir "")
    (
        (set #muilib (tackon #muidir "Libs/muimaster.library"))
        (if (= (exists (tackon #muidir "Libs") (noreq)) 2)
            (set #muilibs (expandpath (tackon #muidir "Libs"))))
        (if (= (exists #muilib (noreq)) 1) (set #muiver (getversion #muilib)))
        (if (> #muiver 0)
            (
                (set #major (/ #muiver 65536))
                (set #muiname "MUI")
                (if (= #major 19) (set #muiname "MUI 3"))
                (if (= #major 20) (set #muiname "MUI 4"))
                (if (>= #major 21) (set #muiname "MUI 5"))
                (set #found (cat #found #muiname " (muimaster.library "
                    (P_Version #muiver) ") in " #muidir
                    (if (<> #muiassign "") " (MUI:)" "") ".\n"))
            )
            (set #found (cat #found "A MUI drawer " #muidir
                " without Libs/muimaster.library.\n"))
        )
    )
)
(if (= 0 (run "C:Search >NIL: S:User-Startup \";BEGIN MUI\" QUIET" (safe)))
    (set #found (cat #found "S:User-Startup has MUI's own lines (;BEGIN MUI).\n"))
)

; muimaster.library in every directory of LIBS: (other LIBS:MUI drawers are
; remembered for the classes, up to three; MUI's own Libs is not one)
(set #other1 "")
(set #other2 "")
(set #other3 "")
(set #realmui (> #muiver 0))
(set #zuneold 0)
(set #i 1)
(while (= 0 (run (cat (P_Quote #tool) " LIBSDIR " #i) (safe)))
    (
        (set #d (getenv "OpenMUI-LibsDir"))
        (set #f (tackon #d "muimaster.library"))
        ; MUI's own Libs drawer is reported above
        (if (and (= (exists #f (noreq)) 1) (<> #d #muilibs))
            (
                (set #iszune (= 0 (run (cat (P_Quote #tool) " ISZUNE " (P_Quote #f)) (safe))))
                (set #found (cat #found #f " " (P_Version (getversion #f))
                    (if #iszune ": OpenMUI" ": not OpenMUI (a real MUI)") ".\n"))
                (if (and #iszune (= #i 1)) (set #zuneold 1))
                (if (not #iszune) (set #realmui 1))
            )
        )
        (if (and (> #i 1) (<> #d #muilibs))
            (if (= #other1 "") (set #other1 #d)
                (if (= #other2 "") (set #other2 #d)
                    (if (= #other3 "") (set #other3 #d))))
        )
        (set #i (+ #i 1))
    )
)
(if (= (exists (tackon #libsdir "muimaster.library.zune68-old") (noreq)) 1)
    (set #found (cat #found (tackon #libsdir "muimaster.library.zune68-old")
        ": Zune68's earlier backup, left as it is.\n"))
)
(set #update (= (exists #manifest (noreq)) 1))
(set #oldrec (tackon (tackon #oldhome "Data") "Manifest"))
(set #old (= (exists #oldrec (noreq)) 1))
(if #old
    (set #found (cat #found "Zune68k lean (this program's old name) is in "
        #oldhome ": removed first, your files put back.\n"))
)
(if #update
    (set #found (cat #found "OpenMUI is installed in " #home ".\n"))
    (if (and #zuneold (not #old))
        (set #found (cat #found "That Zune is not from this installer: "
            "it is kept in the backup.\n"))
    )
)
(if (= (exists "ENVARC:Zune" (noreq)) 2)
    (set #found (cat #found "Your settings (ENVARC:Zune) are kept.\n"))
)
(if (= (exists "ENVARC:MUI" (noreq)) 2)
    (set #found (cat #found "MUI's settings (ENVARC:MUI) are not touched.\n"))
)
(if (= #found "") (set #found "No MUI was found.\n"))

(message "On this Amiga:\n\n" #found "\n"
    (if #realmui
        (cat "Your MUI stays as it is (its files and S:User-Startup "
             "lines too). OpenMUI goes to " #libsdir ", searched first; "
             "\"Use real MUI\" in " #home " switches back.")
        (cat "OpenMUI goes to " #libsdir ". Nothing is added to S:Startup-"
             "Sequence or S:User-Startup."))
    (all)
)

; ---- installed already: update or remove ----
(if #update
    (if (= 1 (askchoice
            (prompt "OpenMUI is installed in " #home ".")
            (help "Install: the earlier installation is removed first (every "
                "file of yours it had replaced is put back), then this one is "
                "installed. Your settings are kept.\n\nRemove: OpenMUI "
                "is removed and your files are put back, as Uninstall in "
                #home " does.")
            (choices "Install this version over it" "Remove OpenMUI")
            (default 0)))
        (
            (set #keep (askbool
                (prompt "Keep your OpenMUI settings (ENVARC:Zune)?")
                (help "The settings are small text files. Keep them if you "
                    "may install OpenMUI again.")
                (choices "Keep them" "Remove them")
                (default 1)))
            (if (= @pretend 0)
                (if (<> 0 (run (cat (P_Quote #tool) " UNINSTALL QUIET HOME="
                        (P_Quote #home) (if #keep "" " SETTINGS"))))
                    (abort "OpenMUI could not be removed completely (a file in "
                        "use or protected?). Its record is kept in " #data
                        ": try again after a reboot.")
                )
            )
            (message "OpenMUI is removed and your own files are back. Reboot "
                "so that no program still uses OpenMUI." (all))
            (exit (quiet))
        )
    )
)

; ---- remove an earlier installation, so that its backups come back ----
(if #update
    (if (= @pretend 0)
        (
            (working "Removing the earlier OpenMUI installation...")
            (if (<> 0 (run (cat (P_Quote #tool) " UNINSTALL QUIET HOME=" (P_Quote #home))))
                (abort "The earlier OpenMUI installation could not be removed "
                    "completely (a file in use or protected?). Nothing new was "
                    "installed. See " #home ", or run \"" #home "/Uninstall\".")
            )
        )
    )
)

; ---- the same program under its old name (Zune68k lean): SYS:Zune68k,
; SYS:Prefs/Zune. Its record lists every file it installed, the drawer and
; the old prefs program too; the tool reads it as it reads ours. ----
(if #old
    (if (= @pretend 0)
        (
            (working "Removing the earlier Zune68k lean installation...")
            (if (<> 0 (run (cat (P_Quote #tool) " UNINSTALL QUIET HOME=" (P_Quote #oldhome))))
                (abort "The earlier Zune68k lean installation could not be "
                    "removed completely (a file in use or protected?). "
                    "Nothing new was installed. See " #oldhome ".")
            )
        )
    )
)
(complete 10)

(set #catalogs (askbool
    (prompt "Install the translations (catalogs for 28 languages) to "
        (tackon #localedir "Catalogs") "?")
    (help "Without them OpenMUI and its classes speak English. They can be "
        "removed again with Uninstall like every other file.")
    (choices "Install" "Skip")
    (default 1)
))

; ---- the Zune68k drawer: the record, the switch, Uninstall ----
(P_OwnDir #home)
(P_OwnDir #data)
(P_OwnDir #backup)
(P_Put (tackon #package "Home/OpenMUI.info") (pathonly #home) "OpenMUI.info")
(P_Put #tool #data "OpenMUISwitch")
(if #realmui
    (
        (P_Put (tackon #package "Home/Use real MUI") #home "Use real MUI")
        (P_Put (tackon #package "Home/Use real MUI.info") #home "Use real MUI.info")
        (P_Put (tackon #package "Home/Use OpenMUI") #home "Use OpenMUI")
        (P_Put (tackon #package "Home/Use OpenMUI.info") #home "Use OpenMUI.info")
    )
)
(P_Put (tackon #package "Home/Uninstall") #home "Uninstall")
(P_Put (tackon #package "Home/Uninstall.info") #home "Uninstall.info")
(P_Put (tackon #package "ReadMe") #home "ReadMe")
(P_Put (tackon #package "Home/ReadMe.info") #home "ReadMe.info")
(P_SaveRecord)
(complete 20)

; ---- the libraries and their own class files ----
(working "Installing the libraries...")
(P_Put (tackon #package "Libs/muimaster.library") #libsdir "muimaster.library")
(P_Put (tackon #package "Libs/zunemaster.library") #libsdir "zunemaster.library")
(P_MakeDir #zunedir)
(foreach (tackon #package "Libs/Zune") "#?.mui"
    (P_Put (tackon (tackon #package "Libs/Zune") @each-name) #zunedir @each-name)
)
(P_SaveRecord)
(complete 40)

; ---- the preferences program ----
(P_Put (tackon #package "Prefs/OpenMUI") "SYS:Prefs" "OpenMUI")
(P_Put (tackon #package "Prefs/OpenMUI.info") "SYS:Prefs" "OpenMUI.info")
(P_SaveRecord)
(complete 50)

; ---- the bundled MUI classes ----
(working "Installing the MUI classes...")
(P_MakeDir #libsmui)
(foreach (tackon #package "Libs/MUI") "#?.mc(c|p)"
    (P_Class @each-name)
)
(P_SaveRecord)
(complete 80)

; ---- translations ----
(if #catalogs
    (
        (working "Installing the translations...")
; COMPONENT_CATALOGS
        (P_SaveRecord)
    )
)
(complete 100)

(if @pretend
    (message "Pretend mode: nothing was changed.\n\n"
        (P_ClassReport))
    (message "OpenMUI 0.1b1 is installed: " #done " files"
        (if (> #nb 0) (cat "; the " #nb " it replaced are kept in " #backup) "")
        ".\n\n"
        (P_ClassReport) "\n"
        "Reboot to use it. " #home " has "
        (if #realmui "\"Use real MUI\" / \"Use OpenMUI\" and " "")
        "Uninstall. Settings: SYS:Prefs/OpenMUI." (all))
)
(exit (quiet))
